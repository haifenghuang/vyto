// vyto/asset — resolve an app's data files (assets/, conf/, storage/) the same
// way whether the app was built with --with-assets (embedded in the binary) or
// not (read from disk, relative to the app root).
//
//     import { assetBytes, assetPath } from "vyto/asset";
//     let png = loadImageBytes(assetBytes("assets/logo.png"));
//     let cfg = json_parse(str(assetBytes("conf/app.json")));
//
// Keys are logical paths relative to the app root, e.g. "assets/logo.png".
// When embedded, the lookup hits the in-binary registry; otherwise it reads
// `{appDir()}/{key}` from disk. `loadImage` and `readfile` already consult
// the same registry, so much existing relative-path code needs no change — this
// module is for explicit access and for getting a real path (assetPath).

import { appDir } from "vyto/os";
import { getenvOr } from "vyto/os";
import { file_open, file_exists, file_mkdirs } from "vyto/io/file";
import { CHAR_SLASH } from "vyto/util/ascii";

// Declared in `runtime/vyto_vfs.h`, defined in `runtime/vyto_vfs.c`.
//
// No `#link` and no `native/src/` shim: vyto_vfs.c is amalgamated into the
// runtime (`#include "vyto_vfs.c"` at the foot of runtime/vyto_rt.c), so
// these four symbols are already in the runtime object every program links.
//
// The registry they read is filled at startup by the generated vyto_assets.c
// when a build passes `--with-assets`, and stays empty otherwise — which is
// why a miss here falls through to disk rather than being an error.
extern "C" {
    fn vt_vfs_size(key: cstring): i64;
    fn vt_vfs_read(key: cstring, buf: cstring, cap: i64): i64;
    fn vt_vfs_size_exact(key: cstring): i64;
    fn vt_vfs_read_exact(key: cstring, buf: cstring, cap: i64): i64;
    fn vt_vfs_ptr_exact(key: cstring): rawptr;
    fn vt_vfs_count(): i32;
    fn vt_vfs_key(i: i32): cstring;
}

// Bytes of an asset: from the embedded registry if present, else from disk
// under appDir(). Panics via file_open if a non-embedded key doesn't exist.
export fn assetBytes(logical: string): byte[] {
    let n = vt_vfs_size(logical.cstr());
    if (n >= 0 as i64) {
        let buf = bytes(n as int);
        if (n > 0 as i64) { vt_vfs_read(logical.cstr(), buf as cstring, n); }
        return buf;
    }
    let f = file_open(`{appDir()}/{logical}`, "rb");
    let d = f.readBytes();
    f.close();
    return d;
}

// True if the asset is embedded or exists on disk.
export fn assetExists(logical: string): bool {
    if (vt_vfs_size(logical.cstr()) >= 0 as i64) { return true; }
    return file_exists(`{appDir()}/{logical}`);
}

// The embedded-only lookups, matching the key EXACTLY.
//
// vt_vfs_get also matches when the registered key is a path-component tail of
// the query, so "assets/404.html" answers a lookup for "/anything/assets/404.html".
// That is convenient for code holding a longer path and wrong for anything
// holding user input: a server passing a request path to assetBytes would serve
// an embedded blob for a URL that merely ends with its name.
//
// These two are for that caller. They also do NOT fall through to disk, which is
// the second half of the same problem -- a file dropped in the working directory
// must not be able to stand in for a page compiled into the binary.
export fn assetBytesExact(logical: string): byte[] {
    let n = vt_vfs_size_exact(logical.cstr());
    if (n < 0 as i64) { return bytes(0); }
    let buf = bytes(n as int);
    if (n > 0 as i64) { vt_vfs_read_exact(logical.cstr(), buf as cstring, n); }
    return buf;
}

export fn assetExistsExact(logical: string): bool {
    return vt_vfs_size_exact(logical.cstr()) >= 0 as i64;
}

// The embedded blob itself, borrowed rather than copied: a pointer into the
// generated asset TU's .rodata, valid for the life of the process, plus its
// length via assetSizeExact. null when the key is not embedded.
//
// This is the one accessor that does NOT fall back to disk and does not copy,
// which is exactly what a response body wants -- ServerResponse.sendBytes takes
// a borrowed pointer, so an embedded page can be served without a str_alloc +
// memcpy per request. The pointer is only safe BECAUSE it is .rodata; nothing
// here hands out a heap buffer.
export fn assetPtrExact(logical: string): rawptr {
    return vt_vfs_ptr_exact(logical.cstr());
}

// Byte length of an embedded asset, or -1 on miss. Pairs with assetPtrExact.
export fn assetSizeExact(logical: string): int {
    return vt_vfs_size_exact(logical.cstr()) as int;
}

// Replace '/' with '_' so a logical path becomes a flat temp filename.
fn flatten(s: string): string {
    let out = "";
    let i = 0;
    while (i < s.len) {
        if (s[i] == CHAR_SLASH) { out = out + "_"; } else { out = out + s.slice(i, i + 1); }   // /
        i += 1;
    }
    return out;
}

// A real filesystem path for the asset. On disk that's `{appDir()}/{key}`; when
// embedded, the blob is materialized to a temp file once and that path returned
// — for consumers that must have a path (e.g. a db opener, a media player).
export fn assetPath(logical: string): string {
    if (vt_vfs_size(logical.cstr()) < 0 as i64) {
        return `{appDir()}/{logical}`;
    }
    let dir = `{getenvOr("TMPDIR", "/tmp")}/vyto-assets`;
    file_mkdirs(dir);
    let out = `{dir}/{flatten(logical)}`;
    if (!file_exists(out)) {
        let f = file_open(out, "wb");
        f.writeBytes(assetBytes(logical));
        f.close();
    }
    return out;
}

// List logical keys directly under `dir` (a logical prefix like "assets"): the
// embedded registry when bundled, else the disk directory under appDir().
export fn assetList(dir: string): string[] {
    let prefix = `{dir}/`;
    let out: string[] = [];
    let n = vt_vfs_count() as int;
    if (n > 0) {
        let i = 0;
        while (i < n) {
            let k = str(vt_vfs_key(i as i32));
            if (k.len > prefix.len && k.slice(0, prefix.len) == prefix) {
                out.push(k);
            }
            i += 1;
        }
        return out;
    }
    // not embedded: read the directory from disk
    for (let name in listdir(`{appDir()}/{dir}`)) {
        out.push(prefix + name);
    }
    return out;
}
